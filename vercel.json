{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "khelogy.com"
        }
      ],
      "destination": "https://www.khelogy.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://render-api.khelogy.com/sitemap.xml"
    },
    {
      "source": "/sitemap-(.*).xml",
      "destination": "https://render-api.khelogy.com/sitemap-$1.xml"
    }
  ],
  "routes": [
    {
      "src": "/sitemap.xml",
      "dest": "https://render-api.khelogy.com/sitemap.xml"
    },
    {
      "src": "/sitemap-(.*).xml",
      "dest": "https://render-api.khelogy.com/sitemap-$1.xml"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}