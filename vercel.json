{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "khelogy.com"
        }
      ],
      "destination": "https://www.khelogy.com/:path*",
      "permanent": true
    }
  ],

  "routes": [
    {
      "src": "/sitemap.xml",
      "dest": "https://render-api.khelogy.com/sitemap.xml"
    },

    {
      "src": "/sitemap_game_category.xml",
      "dest": "https://render-api.khelogy.com/sitemap_game_category.xml"
    },

    {
      "src": "/pages.xml",
      "dest": "https://render-api.khelogy.com/pages.xml"
    },

    {
      "handle": "filesystem"
    },

    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}